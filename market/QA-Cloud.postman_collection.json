          "name": "GET All Groceries",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst body = pm.response.json();\r\n\r\npm.test(\"Response contains products array\", function () {\r\n    pm.expect(body.products).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Products array is not empty\", function () {\r\n    pm.expect(body.products.length).to.be.at.least(1);\r\n});"
                ]
              }
            }
